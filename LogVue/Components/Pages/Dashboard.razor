@page "/"
@implements IAsyncDisposable

<AppShell ShowSearch="false" ShowThemePicker="false" ShowUserMenu="false" ShowVersion="false" CollapsibleSidebar="false">
    <Sidebar>
        <nav class="nf-sidebar" id="nf-sidebar" aria-label="Overview">
            <BrandLink />
            <div class="nf-sidebar-scroll">
                <SectionNav />
                <p class="lv-muted lv-small">Tiles and charts follow the range in the header. Open a tile to search that slice.</p>
            </div>
            <div class="nf-sidebar-footer">
                <h3 class="lv-sidebar-heading">Log store</h3>
                <dl class="lv-store-facts">
                    <dt><Icon Name="database" /> Provider</dt>
                    <dd>@(summary?.ProviderName ?? "–")</dd>
                    <dt>Entries</dt>
                    <dd>@(summary is null ? "–" : summary.TotalCount.ToString("N0", CultureInfo.CurrentCulture))</dd>
                    <dt>Oldest</dt>
                    <dd title="@(summary?.OldestUtc is DateTime oldest ? time.FormatLong(oldest) : null)">
                        @(summary?.OldestUtc is DateTime o ? TimeDisplay.Relative(o, UtcNow) : "–")
                    </dd>
                </dl>
                <p class="lv-muted lv-small">Storing @minimumLevel and above.</p>
                <a class="lv-button lv-button-block" href="@LogsHref(filter)">
                    <Icon Name="search" /> Search the logs
                </a>
            </div>
        </nav>
    </Sidebar>
    <TopbarEnd>
        <div class="lv-topbar-actions">
            <TimeRangePicker Filter="filter" Time="time" OnChange="ApplyFilter" />
            <button type="button" class="lv-icon-button" title="Refresh" disabled="@isLoading" @onclick="RefreshAsync">
                <Icon Name="refresh" Class="@(isLoading ? "lv-spin" : null)" />
            </button>
            <button type="button" class="lv-icon-button lv-zone-button" title="@($"Showing times in {time.Label}. Switch to {(showUtc ? browserTime.Label : "UTC")}.")"
                    @onclick="ToggleUtcAsync">
                <Icon Name="globe" />
                <span>@(showUtc ? "UTC" : "Local")</span>
            </button>
            <ThemeToggle />
        </div>
    </TopbarEnd>
    <ChildContent>
        <div class="lv-dashboard">
            <header class="lv-dash-head">
                <div>
                    <h1>Overview</h1>
                    <p class="lv-muted">@WindowCaption</p>
                </div>
            </header>

            @if (insights is null && loadError is null)
            {
                <div class="lv-stats" aria-hidden="true">
                    @for (int i = 0; i < 6; i++)
                    {
                        <div class="lv-stat lv-stat-skeleton"></div>
                    }
                </div>
            }
            else if (loadError is not null)
            {
                <div class="lv-empty lv-dash-empty">
                    <Icon Name="alert" Class="lv-empty-icon" />
                    <h2>The log store could not be read</h2>
                    <p>@loadError</p>
                    <button type="button" class="lv-button" @onclick="RefreshAsync">Try again</button>
                </div>
            }
            else if (insights is not null && Total == 0)
            {
                <div class="lv-empty lv-dash-empty">
                    <Icon Name="clock" Class="lv-empty-icon" />
                    <h2>No events in this range</h2>
                    <p>
                        Events written through <code>.WriteTo.LogVue(services)</code> at
                        <strong>@minimumLevel</strong> or above will show up here.
                    </p>
                    <a class="lv-button" href="@LogsHref(filter with { Range = TimeRange.All })">Search all logs</a>
                </div>
            }
            else if (insights is not null)
            {
                <div class="lv-stats">
                    @foreach (var level in TileLevels)
                    {
                        <a class="lv-stat lv-level-@level.ToString().ToLowerInvariant()" href="@LevelHref(level)">
                            <span class="lv-stat-label"><span class="lv-stat-dot"></span>@level</span>
                            <span class="lv-stat-value">@CountOf(level).ToString("N0", CultureInfo.CurrentCulture)</span>
                            <span class="lv-stat-delta @DeltaClass(CountOf(level), PreviousCount(level), IncreaseIsBad(level))">
                                @(Delta(CountOf(level), PreviousCount(level)) ?? Rate(CountOf(level)))
                            </span>
                        </a>
                    }
                    <a class="lv-stat lv-level-error" href="@ExceptionsHref()">
                        <span class="lv-stat-label"><Icon Name="alert" Size="14" /> Exceptions</span>
                        <span class="lv-stat-value">@insights.ExceptionCount.ToString("N0", CultureInfo.CurrentCulture)</span>
                        <span class="lv-stat-delta @DeltaClass(insights.ExceptionCount, insights.PreviousExceptionCount, increaseIsBad: true)">
                            @(Delta(insights.ExceptionCount, insights.PreviousExceptionCount) ?? Rate(insights.ExceptionCount))
                        </span>
                    </a>
                    <a class="lv-stat" href="@LogsHref(filter)">
                        <span class="lv-stat-label"><Icon Name="logs" Size="14" /> Total</span>
                        <span class="lv-stat-value">@Total.ToString("N0", CultureInfo.CurrentCulture)</span>
                        <span class="lv-stat-delta lv-muted">@Rate(Total)</span>
                    </a>
                </div>

                <section class="lv-panel">
                    <h2>Volume <span class="lv-muted">@BucketCaption</span></h2>
                    <Chart Config="InsightsCharts.Volume(VolumeLabels, insights.Volume)" Height="md" />
                </section>

                <div class="lv-dash-split">
                    <section class="lv-panel">
                        <h2>By level</h2>
                        <Chart Config="InsightsCharts.Levels(insights.Levels)" Height="md" />
                    </section>
                    <section class="lv-panel">
                        <h2>Top sources</h2>
                        @if (insights.TopSources.Count == 0)
                        {
                            <p class="lv-muted">No <code>SourceContext</code> on events in this range.</p>
                        }
                        else
                        {
                            <Chart Config="InsightsCharts.Names(insights.TopSources)" Height="md" />
                        }
                    </section>
                </div>

                <section class="lv-panel">
                    <h2>Repeating messages</h2>
                    @if (insights.TopTemplates.Count == 0)
                    {
                        <p class="lv-muted">Nothing to group yet.</p>
                    }
                    else
                    {
                        <ol class="lv-rank">
                            @foreach (var template in insights.TopTemplates)
                            {
                                long widest = insights.TopTemplates[0].Count;
                                double width = widest == 0 ? 0 : Math.Max(template.Count * 100.0 / widest, 2);
                                <li>
                                    <a href="@TemplateHref(template.Name)">
                                        <span class="lv-rank-label">
                                            <span title="@template.Name">@template.Name</span>
                                            <span>@template.Count.ToString("N0", CultureInfo.CurrentCulture)</span>
                                        </span>
                                        <span class="lv-rank-track">
                                            <span class="lv-rank-fill" style="width: @(width.ToString("0", CultureInfo.InvariantCulture))%"></span>
                                        </span>
                                    </a>
                                </li>
                            }
                        </ol>
                    }
                </section>
            }
        </div>
    </ChildContent>
</AppShell>
