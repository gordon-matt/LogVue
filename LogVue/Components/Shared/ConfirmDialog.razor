@* Driven from C#, so callers can await a decision instead of wiring callbacks. *@
@if (isVisible)
{
    <div class="lv-modal-backdrop" @onclick="() => Close(false)"></div>
    <div class="lv-modal" role="alertdialog" aria-modal="true" aria-labelledby="lv-confirm-title">
        <h2 class="lv-modal-title" id="lv-confirm-title">@title</h2>
        <p>@message</p>
        @if (detail is not null)
        {
            <p class="lv-muted lv-small">@detail</p>
        }
        <div class="lv-modal-actions">
            <button type="button" class="lv-button" @onclick="() => Close(false)">Cancel</button>
            <button type="button" class="lv-button @(isDestructive ? "lv-button-danger" : "lv-button-primary")"
                    @onclick="() => Close(true)">
                @confirmLabel
            </button>
        </div>
    </div>
}

@code {
    private bool isVisible;
    private string title = string.Empty;
    private string message = string.Empty;
    private string? detail;
    private string confirmLabel = "OK";
    private bool isDestructive;
    private TaskCompletionSource<bool>? completion;

    /// <summary>Shows the dialog and completes when the user answers.</summary>
    public Task<bool> ShowAsync(
        string title,
        string message,
        string confirmLabel = "OK",
        bool isDestructive = false,
        string? detail = null)
    {
        this.title = title;
        this.message = message;
        this.detail = detail;
        this.confirmLabel = confirmLabel;
        this.isDestructive = isDestructive;

        isVisible = true;
        completion = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);

        StateHasChanged();

        return completion.Task;
    }

    private void Close(bool confirmed)
    {
        isVisible = false;
        completion?.TrySetResult(confirmed);
        completion = null;
    }
}
