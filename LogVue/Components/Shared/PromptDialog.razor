@* Asks for one line of text; completes with null when cancelled. *@
@if (isVisible)
{
    <div class="lv-modal-backdrop" @onclick="Cancel"></div>
    <div class="lv-modal" role="dialog" aria-modal="true" aria-labelledby="lv-prompt-title">
        <form @onsubmit="Submit">
            <h2 class="lv-modal-title" id="lv-prompt-title">@title</h2>
            @if (description is not null)
            {
                <p class="lv-muted lv-small">@description</p>
            }
            <label class="lv-field">
                <span>@label</span>
                <input class="lv-input" @ref="input" @bind="value" @bind:event="oninput" maxlength="@maxLength" />
            </label>
            <div class="lv-modal-actions">
                <button type="button" class="lv-button" @onclick="Cancel">Cancel</button>
                <button type="submit" class="lv-button lv-button-primary" disabled="@string.IsNullOrWhiteSpace(value)">
                    @confirmLabel
                </button>
            </div>
        </form>
    </div>
}

@code {
    private bool isVisible;
    private bool focusPending;
    private string title = string.Empty;
    private string? description;
    private string label = string.Empty;
    private string confirmLabel = "OK";
    private string? value;
    private int maxLength = 256;
    private ElementReference input;
    private TaskCompletionSource<string?>? completion;

    public Task<string?> ShowAsync(
        string title,
        string label,
        string? initialValue = null,
        string confirmLabel = "OK",
        string? description = null,
        int maxLength = 256)
    {
        this.title = title;
        this.label = label;
        this.description = description;
        this.confirmLabel = confirmLabel;
        this.maxLength = maxLength;
        value = initialValue;

        isVisible = true;
        focusPending = true;
        completion = new TaskCompletionSource<string?>(TaskCreationOptions.RunContinuationsAsynchronously);

        StateHasChanged();

        return completion.Task;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusPending && isVisible)
        {
            focusPending = false;
            await input.FocusAsync(preventScroll: true);
        }
    }

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        isVisible = false;
        completion?.TrySetResult(value.Trim());
        completion = null;
    }

    private void Cancel()
    {
        isVisible = false;
        completion?.TrySetResult(null);
        completion = null;
    }
}
