<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Description>An in-process Blazor dashboard for viewing, querying and deleting an ASP.NET Core application's logs.</Description>
		<PackageTags>logging;log-viewer;dashboard;blazor;razor-class-library;aspnetcore;ilogger;structured-logging;serilog;nlog;log4net;sejil</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LogVue.Services\LogVue.Services.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="LogVue.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="build\LogVue.props" Pack="true" PackagePath="build;buildTransitive" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Heroicsoft.NetForge.Components" />
		<PackageReference Include="Heroicsoft.NetForge.WebAssets" />
	</ItemGroup>
</Project>