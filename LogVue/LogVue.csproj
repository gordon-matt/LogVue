<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Description>An in-process Blazor dashboard for viewing, querying and deleting an ASP.NET Core application's logs.</Description>
		<Version>1.1.1</Version>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="LogVue.Tests" />
	</ItemGroup>

	<ItemGroup>
		<!--
		  Served by LogVue's own endpoint rather than as static web assets, so the dashboard works
		  whether or not the host calls UseStaticFiles or MapStaticAssets.
		-->
		<EmbeddedResource Include="Assets\*" LogicalName="LogVue.Assets.%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<None Include="build\LogVue.props" Pack="true" PackagePath="build;buildTransitive" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Heroicsoft.NetForge.Components" Version="1.1.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LogVue.Services\LogVue.Services.csproj" />
	</ItemGroup>
</Project>