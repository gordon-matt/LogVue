<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Description>Contracts for writing events into the LogVue log dashboard. A provider package references this and nothing else from LogVue.</Description>
		<PackageTags>logging;log-viewer;abstractions;log-provider;structured-logging</PackageTags>
		<RootNamespace>LogVue.Providers</RootNamespace>
	</PropertyGroup>

</Project>
