<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Description>Serilog sink for the LogVue log dashboard. Reference this only when the host logs through Serilog's own pipeline.</Description>
		<Version>1.1.0</Version>
		<RootNamespace>LogVue.Providers.Serilog</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="LogVue.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
		<PackageReference Include="Serilog" Version="4.4.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LogVue.Providers.Abstractions\LogVue.Providers.Abstractions.csproj" />
	</ItemGroup>

</Project>
