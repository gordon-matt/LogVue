<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.collector">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="Moq" />
		<PackageReference Include="xunit" />
		<PackageReference Include="xunit.runner.visualstudio">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
		<Using Include="LogVue.Providers" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LogVue\LogVue.csproj" />
		<ProjectReference Include="..\LogVue.Data.MySql\LogVue.Data.MySql.csproj" />
		<ProjectReference Include="..\LogVue.Data.Npgsql\LogVue.Data.Npgsql.csproj" />
		<ProjectReference Include="..\LogVue.Data.Sql\LogVue.Data.Sql.csproj" />
		<ProjectReference Include="..\LogVue.Data.Sqlite\LogVue.Data.Sqlite.csproj" />
		<ProjectReference Include="..\LogVue.Providers.Serilog\LogVue.Providers.Serilog.csproj" />
		<ProjectReference Include="..\LogVue.Services\LogVue.Services.csproj" />
	</ItemGroup>

</Project>
