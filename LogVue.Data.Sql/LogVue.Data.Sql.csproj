<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Description>SQL Server storage for the LogVue log dashboard.</Description>
		<PackageTags>logging;log-viewer;entity-framework-core;efcore;sqlserver;mssql</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LogVue.Data\LogVue.Data.csproj" />
	</ItemGroup>

</Project>
