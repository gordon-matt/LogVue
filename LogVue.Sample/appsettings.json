{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "NLog": {
    "throwConfigExceptions": true,
    "targets": {
      "console": {
        "type": "Console",
        "layout": "${longdate} ${level:uppercase=true:padding=-5} ${logger} ${message}${exception:format=tostring}"
      }
    },
    "rules": [
      {
        "logger": "Microsoft.*",
        "maxLevel": "Info",
        "final": true
      },
      {
        "logger": "System.*",
        "maxLevel": "Info",
        "final": true
      },
      {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "console"
      }
    ]
  },
  "Sample": {
    // Microsoft, NLog, Log4Net or Serilog. NLog and log4net sit beside LogVue.
    // Serilog replaces the Microsoft pipeline and uses the LogVue sink.
    "LoggingProvider": "Log4Net"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "LogVue": "Data Source=logvue-sample.db"
  },
  "LogVue": {
    //"LogoPath": "~/path/to/your/logo.png",
    //"Title": "Your Brand", // Use this if you don't supply a logo. If neither are supplied, then the default LogVue logo will be used.
    "RetentionDays": 30
  },
  "AllowedHosts": "*"
}