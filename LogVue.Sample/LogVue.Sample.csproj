<Project Sdk="Microsoft.NET.Sdk.Web">

	<!-- What the LogVue package imports into consumers automatically; a project reference doesn't. -->
	<Import Project="..\LogVue\build\LogVue.props" />

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Log4Net.AspNetCore" Version="10.0.0" />
		<PackageReference Include="NLog.Extensions.Logging" Version="6.2.2" />
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Update="log4net.config">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LogVue.Providers.Serilog\LogVue.Providers.Serilog.csproj" />
		<ProjectReference Include="..\LogVue\LogVue.csproj" />
		<ProjectReference Include="..\LogVue.Data.MySql\LogVue.Data.MySql.csproj" />
		<ProjectReference Include="..\LogVue.Data.Npgsql\LogVue.Data.Npgsql.csproj" />
		<ProjectReference Include="..\LogVue.Data.Sql\LogVue.Data.Sql.csproj" />
		<ProjectReference Include="..\LogVue.Data.Sqlite\LogVue.Data.Sqlite.csproj" />
	</ItemGroup>

</Project>
